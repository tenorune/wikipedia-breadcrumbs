# Supabase credentials — get these from your Supabase project dashboard
# Settings → API → Project URL and anon/public key

# For Chrome extension (Vite convention)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# For PWA (SvelteKit convention — same values as above)
PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Google OAuth (for PWA sign-in)
PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
