{
  "name": "@wikipedia-breadcrumbs/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "svelte": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*.svelte": {
      "svelte": "./src/*.svelte",
      "default": "./src/*.svelte"
    }
  },
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "dependencies": {
    "@wikipedia-breadcrumbs/shared": "workspace:*"
  },
  "devDependencies": {
    "svelte": "^5.55.7",
    "svelte-check": "^4.1.0",
    "typescript": "^5.7.0"
  }
}
